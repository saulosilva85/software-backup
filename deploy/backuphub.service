# Referência: o install.sh gera este arquivo automaticamente em /etc/systemd/system/.
[Unit]
Description=BackupHub - backup de servidores on-premise, AWS e GCP
After=network-online.target
Wants=network-online.target

[Service]
User=backuphub
ExecStart=/opt/backuphub/bin/backuphub-server
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
